# FinGuard AI — Environment Configuration
# Copy this file to .env and fill in real values before starting the platform.
# start_platform.sh will source .env automatically if it exists.

# ──────────────────────────────────────────────────────────────────────────────
# OPTION A — Generic / GPT-OSS-120B provider (highest priority)
#
# Set FIN_GUARD_LLM_PROVIDER to any non-empty string to activate this path.
# The agent will build an OpenAI-compatible client pointed at FIN_GUARD_LLM_BASE_URL.
# ──────────────────────────────────────────────────────────────────────────────
# FIN_GUARD_LLM_PROVIDER=gpt-oss-120b
# FIN_GUARD_LLM_MODEL=gpt-oss-120b
# FIN_GUARD_LLM_BASE_URL=https://<your-provider-endpoint>/v1
# FIN_GUARD_LLM_API_KEY=<your-provider-api-key>

# ──────────────────────────────────────────────────────────────────────────────
# OPTION B — Google Gemini (via OpenAI-compatible adapter)
# Used automatically when only GEMINI_API_KEY is set.
# ──────────────────────────────────────────────────────────────────────────────
# GEMINI_API_KEY=<your-gemini-api-key>

# ──────────────────────────────────────────────────────────────────────────────
# OPTION C — OpenAI (default, gpt-4o-mini)
# Used when OPENAI_API_KEY is set and no generic provider is configured.
# ──────────────────────────────────────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
